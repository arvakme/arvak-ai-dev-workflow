{
  "name": "arvak-ai-dev-workflow",
  "version": "0.3.0",
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "packages/butler-ui/index.ts",
      "packages/butler-ui/provider/index.ts"
    ],
    "skills": [
      "packages/skills"
    ],
    "themes": [
      "packages/butler-ui/themes"
    ]
  },
  "scripts": {
    "test": "bun test --timeout 90000 tests/asset-integrity.test.ts tests/web-search.test.ts packages/butler-ui/tests",
    "test:pi-smoke": "bun test --timeout 15000 packages/butler-ui/provider/openai-native/test/pi-smoke.test.ts",
    "test:bcu": "npm --prefix packages/better-computer-use test",
    "test:assets": "bun test --timeout 30000 tests/asset-integrity.test.ts tests/web-search.test.ts"
  }
}
