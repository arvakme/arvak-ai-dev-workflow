{
  "name": "pi-butler-ui",
  "version": "0.8.1",
  "description": "Pi terminal UI, session presets, provider configuration and an animated terminal Butler companion",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arvakme/arvak-ai-dev-workflow.git",
    "directory": "packages/butler-ui"
  },
  "homepage": "https://github.com/arvakme/arvak-ai-dev-workflow/tree/main/packages/butler-ui",
  "bugs": {
    "url": "https://github.com/arvakme/arvak-ai-dev-workflow/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "files": [
    "*.ts",
    "config.example.jsonc",
    "provider/claude-sub.ts",
    "provider/openai-native/index.ts",
    "provider/openai-native/src/compact-client.ts",
    "provider/openai-native/src/config.ts",
    "provider/openai-native/src/extension.ts",
    "provider/openai-native/src/native-compaction.ts",
    "provider/openai-native/src/native-details.ts",
    "provider/openai-native/src/native-replay.ts",
    "provider/openai-native/src/native-runtime.ts",
    "provider/openai-native/src/options.ts",
    "provider/openai-native/src/request-pipeline.ts",
    "provider/openai-native/src/responses-input.ts",
    "!provider/openai-native/src/*.test.ts",
    "session/*.ts",
    "statusbar/*.ts",
    "tools/*.ts",
    "themes/*.json",
    "provider/index.ts"
  ],
  "scripts": {
    "test": "bun test"
  },
  "pi": {
    "extensions": [
      "./index.ts",
      "./provider/index.ts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
