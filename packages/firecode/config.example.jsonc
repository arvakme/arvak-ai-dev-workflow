{
	// arvak：模型一律 "provider/model/thinking"。通知走 Moshi，Agent 调度走 Seedmux，pet 显示常驻 NONO。
	"features": {
		"header": true,
		"statusbar": true,
		"tools": true,
		"presets": true,
		"rename": true,
		"stats": true,
		"claudeSub": false,
		"openaiNative": true,
		"pet": true
	},

	"keys": {
		"rename": "ctrl+r",
		"cyclePreset": "ctrl+shift+u",
		"fast": "ctrl+f"
	},

	"openai": {
		"nativeCompaction": true,
		"providers": {
			"xai": {
				"priority": true
			}
		}
	},

	"presets": {
		"grok": { "model": "xai/grok-4.6/xhigh", "key": "alt+1" }
	}
}
