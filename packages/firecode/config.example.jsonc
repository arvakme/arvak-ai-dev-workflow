{
	// arvak：模型一律 "provider/model/thinking"。通知走 Moshi，没有 Bark。
	"features": {
		"header": true,
		"statusbar": true,
		"tools": true,
		"presets": true,
		"rename": true,
		"stats": true,
		"claudeSub": false,
		"openaiNative": true,
		"workingFlame": true,
		"review": true,
		"master": true,
		"watcher": true
	},

	"keys": {
		"rename": "ctrl+r",
		"cyclePreset": "ctrl+shift+u",
		"fast": "ctrl+f"
	},

	"openai": {
		"nativeCompaction": true,
		"providers": {
			"xai": {
				"priority": true
			}
		}
	},

	"watcher": {
		"enabled": true,
		"model": "xai/grok-4.6/xhigh",
		"context": "minimal"
	},

	"master": {
		"autoActivate": true,
		"workerExcludeExtensions": [],
		"roles": {
			"调研员": {
				"model": "xai/grok-4.6/xhigh",
				"use": "大规模并行调研，不做实现"
			},
			"工程师": {
				"model": "xai/grok-4.6/xhigh",
				"use": "默认实现/调试",
				"fallback": ["xai/grok-4.6/xhigh"]
			},
			"全栈": {
				"model": "xai/grok-4.6/xhigh",
				"use": "前端/审美/综合实现",
				"fallback": ["xai/grok-4.6/xhigh"]
			},
			"架构师": {
				"model": "xai/grok-4.6/xhigh",
				"use": "架构与关键实现，启用前先问用户"
			},
			"设计师": {
				"model": "xai/grok-4.6/xhigh",
				"use": "纯视觉"
			},
			"哨兵": {
				"model": "xai/grok-4.6/xhigh",
				"use": "CI/部署/长测试盯守"
			}
		}
	},

	"presets": {
		"grok": { "model": "xai/grok-4.6/xhigh", "key": "alt+1" }
	},

	"review": {
		"advisor": "xai/grok-4.6/xhigh",
		"reviewers": ["xai/grok-4.6/xhigh"],
		"maxRounds": 5,
		"advisorAfterFailures": 2,
		"timeoutMinutes": 20,
		"tools": ["read", "grep", "find", "ls", "bash"],
		"language": "zh"
	}
}
